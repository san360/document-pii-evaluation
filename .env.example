# ---------------------------------------------------------------------------
# Azure AI Language — the Document PII API.
#   POST /language/analyze-documents/jobs
#
# A single-service Language resource is what the native document API is
# documented against. The endpoint looks like:
#   https://<name>.cognitiveservices.azure.com
# ---------------------------------------------------------------------------
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Default api-version. The UI and --api-version override it per run.
#   2026-05-01 (GA) | 2026-05-15-preview
# The api-version decides which PII categories are accepted: both 2026 versions
# refuse 3 of the 177, and Document PII rejects the *whole request* over one
# unsupported category. See the Diagnostics tab for the matrix.
AZURE_DOCUMENT_PII_API_VERSION=2026-05-01

# ---------------------------------------------------------------------------
# Azure Blob Storage — required. The API cannot accept an uploaded file: it
# reads its source from a blob and writes its output to a container you own.
# Both containers are created on first use if they do not exist.
#
# Set the connection string for key auth, or ACCOUNT_URL alone when
# AZURE_USE_ENTRA_ID=true (SAS is then minted from a user delegation key).
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_SOURCE_CONTAINER=pii-source
AZURE_STORAGE_TARGET_CONTAINER=pii-target

# ---------------------------------------------------------------------------
# Auth mode. false uses the key above. true uses DefaultAzureCredential
# (az login) and ignores it — grant your principal 'Cognitive Services User' on
# the Language resource and 'Storage Blob Data Contributor' on the storage
# account. Owning the subscription is a control-plane role and is not enough;
# every call here is data-plane.
# ---------------------------------------------------------------------------
AZURE_USE_ENTRA_ID=false
