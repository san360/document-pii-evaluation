# ---------------------------------------------------------------------------
# Local working folders. All hold data derived from real documents, so all are
# excluded — but their READMEs are kept so a clone still explains them.
# ---------------------------------------------------------------------------
docs/*
!docs/README.md
# Document PII evaluation output: redacted copies of your documents plus the
# service's result JSON, which lists every PII value it found verbatim.
evaluations/

# ---------------------------------------------------------------------------
# Documents. Belt and braces: block PDFs anywhere, not only under docs/.
# The sample generator is committed; the PDFs it produces are not, so nobody
# has to decide case-by-case whether a given file is synthetic or real.
# ---------------------------------------------------------------------------
*.pdf
*.PDF

# Environment / secrets
.env
.env.local
*.pem
*.key

# azd environment state. Holds the selected subscription, resource names and
# the values the postprovision hook used to write .env — deployment state, not
# source, and specific to one person's subscription.
.azure/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch
tmp/
*.log

# compiled bicep output (generated by 'az bicep build')
infra/main.json
